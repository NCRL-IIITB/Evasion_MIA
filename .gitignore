# Python, environments, editors, OS junk
# =============================================================================
__pycache__/
*.py[cod]
*.tmp
*.tmp.*
.ipynb_checkpoints/
mia_env/
env/
venv/
.venv/
.env
.idea/
.vscode/
.DS_Store
__MACOSX/
._*
